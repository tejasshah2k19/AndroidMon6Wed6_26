<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CallActivity">

    <ListView
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:id="@+id/lvCallListCalls"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:id="@+id/linearCallButtonLayout"
        android:layout_below="@id/lvCallListCalls"
        android:orientation="horizontal"
        >
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/imgBtnCallCallList"
                android:layout_weight="1"
                android:src="@drawable/phone_call_black"
                android:scaleType="fitCenter"
                 android:padding="25dp"
                />


        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:id="@+id/imgBtnCallChatList"
            android:layout_weight="1"
            android:src="@drawable/status_black"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:padding="25dp"
            />


        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:id="@+id/imgBtnCallStatusList"
            android:layout_weight="1"
            android:src="@drawable/chat_black"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:padding="25dp"
            />

    </LinearLayout>

</RelativeLayout>