<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CalcActivity"

    >


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvCalcN1"
            android:text="No.1"
            android:textSize="10pt"
            android:layout_marginTop="150dp"
            android:layout_marginStart="30dp"
            />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etCalcN1"
            android:layout_toEndOf="@id/tvCalcN1"
            android:layout_marginTop="150dp"
            android:layout_marginEnd="30dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvCalcN2"
            android:text="No.2"
            android:layout_below="@id/tvCalcN1"
            android:layout_marginStart="30dp"
            android:textSize="10pt"
            android:layout_marginTop="30dp"
            />

         <EditText
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:id="@+id/etCalcN2"

             android:layout_toEndOf="@id/tvCalcN2"
             android:layout_marginTop="210dp"
             android:layout_marginEnd="30dp"
             />


        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnCalcAdd"
            android:text="Add"
                android:layout_below="@id/etCalcN2"
            android:layout_marginTop="30dp"
                android:layout_centerHorizontal="true"
            />

</RelativeLayout>